  "dependencies": {
    "@ckeditor/ckeditor5-vue": "^7.3.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/google-calendar": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/list": "^6.1.15",
    "@fullcalendar/multimonth": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "buffer": "^6.0.3",
    "ckeditor5": "^44.3.0",
    "dayjs": "^1.11.13",
    "element-plus": "^2.9.6",
    "firebase": "^11.4.0",
    "lodash-unified": "^1.0.3",
    "qrcode": "^1.5.4",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "@element-plus/nuxt": "^1.1.1",
    "@nuxt/eslint": "^0.7.6",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^0.9.0",
    "@types/qrcode": "^1.5.5",
    "@types/validator": "^13.12.2",
    "@vueuse/nuxt": "^13.0.0",
    "nuxt": "^3.16.0",
    "sass": "^1.85.1",
    "typescript": "^5.8.2",
    "vue-tsc": "^2.2.8"
  },
  "peerDependencies": {
    "pinia": "^2.1.6"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "webpack",
        "vite",
        "vue"
